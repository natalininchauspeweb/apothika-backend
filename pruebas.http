# ==========================================
# VARIABLES AUTOMÁTICAS DEL ARCHIVO
# ==========================================
@token = {{loginFarmacia.response.body.token}}
@idProducto = {{obtenerCatalogo.response.body.$[0]._id}}


# ==========================================
# 1. AUTENTICACIÓN Y USUARIOS (JWT)
# ==========================================

### 1.1 Login de Farmacia (1º: Ejecutar PRIMERO haciendo clic en Send Request acá)
# @name loginFarmacia
POST http://127.0.0.1:3000/api/auth/login
Content-Type: application/json

{
  "email": "contacto@farmaciadalton.com",
  "password": "PasswordSegura123"
}

### 1.2 Login de Paciente (Julieta Martínez)
POST http://127.0.0.1:3000/api/auth/login
Content-Type: application/json

{
  "email": "julieta@ejemplo.com",
  "password": "Password123"
}

### 1.3 Registrar un paciente nuevo
POST http://127.0.0.1:3000/api/auth/register
Content-Type: application/json

{
  "nombre": "Julieta Martínez",
  "email": "julieta@ejemplo.com",
  "password": "Password123",
  "rol": "paciente"
}


# ==========================================
# 2. TRANSACCIONES Y BILLETERA DE PUNTOS
# ==========================================

### 2.1 Cargar 500 puntos a Julieta Martínez ($50.000 = 500 pts)
POST http://127.0.0.1:3000/api/transacciones/sumar
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "emailPaciente": "julieta@ejemplo.com",
  "montoGastado": 50000
}

### 2.2 Consultar historial de transacciones registradas (Entidad 3 - READ)
GET http://127.0.0.1:3000/api/transacciones
Authorization: Bearer {{token}}


# ==========================================
# 3. OPERACIONES CRUD DEL CATÁLOGO
# ==========================================

### 3.1 Obtener catálogo completo - Operación READ (Captura el 1er ID automáticamente)
# @name obtenerCatalogo
GET http://127.0.0.1:3000/api/productos
Authorization: Bearer {{token}}

### 3.2 Canjear un producto con puntos (Usa el ID capturado en 3.1)
POST http://127.0.0.1:3000/api/transacciones/canjear
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "emailPaciente": "julieta@ejemplo.com",
  "idProducto": "{{idProducto}}"
}

### 3.3 Actualizar un producto - Operación UPDATE del CRUD (Usa el ID capturado en 3.1)
PUT http://127.0.0.1:3000/api/productos/{{idProducto}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nombre": "Emulsión Corporal Vitamina A",
  "descripcion": "Hidratación profunda 500ml",
  "puntosOtorga": 70,
  "imagenUrl": "http://localhost:3000/images/imagen-01.webp"
}

### 3.4 Eliminar un producto - Operación DELETE del CRUD (Usa el ID capturado en 3.1)
DELETE http://127.0.0.1:3000/api/productos/{{idProducto}}
Authorization: Bearer {{token}}


# ==========================================
